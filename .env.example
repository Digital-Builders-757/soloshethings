# =============================================================================
# SoloSHEThings — environment template (safe to commit)
# Copy:  cp .env.example .env.local
# Mirror these keys in Vercel → Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Required for marketing-interest capture on the homepage (`submitMarketingInterest` server action, `marketing_interest` table).
# Signup and profile flows require tables from supabase/migrations (e.g. public.profiles).
# After creating a project, apply migrations: supabase link && supabase db push — or paste the SQL from supabase/migrations into the SQL editor.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Local `.env.local`: http://localhost:3000
# Hosted envs (Vercel Production/Preview): set this to the public site origin for that environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# WordPress (headless blog) — see lib/wp-env.ts, lib/wp-rest.ts
# -----------------------------------------------------------------------------
# Site origin ONLY (no /wp-json). The app appends /wp-json/wp/v2/...
WORDPRESS_URL=https://your-wordpress-host.example.com
# Legacy alias:
# WP_URL=https://your-wordpress-host.example.com

# POST /api/revalidate — secret must appear in the webhook JSON body.
WORDPRESS_REVALIDATE_SECRET=generate_a_long_random_string
# Legacy alias:
# REVALIDATE_SECRET=generate_a_long_random_string

# GET /api/preview?secret=...&slug=... (draft preview)
PREVIEW_SECRET=generate_a_long_random_string

# Not read by this codebase (optional note for humans / external docs):
# WORDPRESS_API_URL=https://.../wp-json

# -----------------------------------------------------------------------------
# Stripe — membership checkout + webhooks (/api/webhooks/stripe)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
# Recurring USD price configured in Stripe (e.g. $3.99/mo per BILLING_STRIPE_CONTRACT).

# -----------------------------------------------------------------------------
# Resend (when transactional email is enabled)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Solo SHE Things <hello@yourdomain.com>

# -----------------------------------------------------------------------------
# Monitoring (Sentry) — see docs/proof/MONITORING_SENTRY_POSTURE.md
# -----------------------------------------------------------------------------
# Runtime: at least one of these so server/edge/client can report (server skips init if unset).
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# Optional: same DSN as NEXT_PUBLIC_* if you want an explicit server-only override.
#
# Build / Vercel: org + project enable withSentryConfig (tunnel /monitoring + webpack). Add AUTH for source maps.
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=
# Local wizard may create .env.sentry-build-plugin (gitignored); do not commit tokens.
#
# Silence coarse funnel `product_signal` structured Logs while keeping error capture — see MONITORING_SENTRY_POSTURE.md
# DISABLE_PRODUCT_SIGNALS=
