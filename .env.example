# =============================================================================
# SoloSHEThings — environment template (safe to commit)
# Copy:  cp .env.example .env.local
# Mirror these keys in Vercel → Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# WordPress (headless blog) — see lib/wp-env.ts, lib/wp-rest.ts
# -----------------------------------------------------------------------------
# Site origin ONLY (no /wp-json). The app appends /wp-json/wp/v2/...
WORDPRESS_URL=https://your-wordpress-host.example.com
# Legacy alias:
# WP_URL=https://your-wordpress-host.example.com

# POST /api/revalidate — secret must appear in the webhook JSON body.
WORDPRESS_REVALIDATE_SECRET=generate_a_long_random_string
# Legacy alias:
# REVALIDATE_SECRET=generate_a_long_random_string

# GET /api/preview?secret=...&slug=... (draft preview)
PREVIEW_SECRET=generate_a_long_random_string

# Not read by this codebase (optional note for humans / external docs):
# WORDPRESS_API_URL=https://.../wp-json

# -----------------------------------------------------------------------------
# Stripe (when billing is enabled)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...

# -----------------------------------------------------------------------------
# Resend (when email is enabled)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_...

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=
